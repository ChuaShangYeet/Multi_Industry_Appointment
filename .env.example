# --- App ---
APP_NAME="Appointment Backend"
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local dev with zero setup (default if unset): sqlite:///./dev.db
# Production (Postgres, recommended): postgresql+psycopg://user:password@localhost:5432/appointments
# (also `pip install -r requirements-postgres.txt` - see README)
DATABASE_URL=sqlite:///./dev.db

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of origins allowed to call this API (your frontend's URL(s)).
# Default covers frontend/'s Vite dev server (port 5173) on both localhost and
# 127.0.0.1 out of the box.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Google Calendar Sync ---
# Leave disabled until you have real Google Cloud OAuth credentials.
# When disabled, the booking flow still works, sync calls are just skipped/logged.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Service account used to write into each business's calendar (share that
# calendar with the service account's email address in Google Calendar's
# sharing settings). Not needed while GOOGLE_CALENDAR_ENABLED=false.
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Admin bootstrap ---
# Used by `python -m app.bootstrap_admin` to create the first SuperAdmin account.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeThis123!
