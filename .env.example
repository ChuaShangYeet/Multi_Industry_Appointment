# --- App ---
APP_NAME="Appointment Backend"
ENVIRONMENT=development
DEBUG=true

# --- Database ---
# Local dev with zero setup (default if unset): sqlite:///./dev.db
# Production (Postgres, recommended): postgresql+psycopg://user:password@localhost:5432/appointments
# (also `pip install -r requirements-postgres.txt` - see README)
DATABASE_URL=sqlite:///./dev.db

# --- Auth / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated list of origins allowed to call this API (your frontend's URL(s)).
# Default covers frontend/'s Vite dev server (port 5173) on both localhost and
# 127.0.0.1 out of the box. For a single-tenant deployment fronted by
# WordPress, list that site's real origin(s) instead, e.g.:
#   CORS_ORIGINS=https://clientdomain.com.my,http://localhost:8080
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# --- Google Calendar Sync ---
# Leave disabled until you have real Google Cloud OAuth credentials.
# When disabled, the booking flow still works, sync calls are just skipped/logged.
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Service account used to write into each business's calendar (share that
# calendar with the service account's email address in Google Calendar's
# sharing settings). Not needed while GOOGLE_CALENDAR_ENABLED=false.
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- Admin bootstrap ---
# Used by `python -m app.bootstrap_admin` to create the first SuperAdmin account.
FIRST_ADMIN_EMAIL=admin@example.com
FIRST_ADMIN_PASSWORD=ChangeThis123!

# --- Single-tenant deployment (Path 2) ---
# Set to true for a dedicated one-client-per-instance deployment (e.g. behind
# a WordPress marketing site): disables the public multi-business marketplace
# (GET /businesses, POST /auth/business/register) and exposes
# /api/v1/business/{profile,services,staff,inventory,slots} - the same public
# data as /businesses/{id}/..., auto-resolved to the one business below, so
# your frontend never needs to know a business_id. Leave false for the normal
# multi-tenant marketplace behavior (this is what the test suite runs under).
SINGLE_TENANT_MODE=false
# Read only by `python -m app.bootstrap_tenant` to create that one business
# (Approved immediately - no marketplace review step to wait on).
TENANT_BUSINESS_EMAIL=owner@example.com
TENANT_BUSINESS_PASSWORD=ChangeThis123!
TENANT_BUSINESS_NAME=My Business
# One of: Restaurant, Hotel, Spa, Car Service, Professional, Salon
TENANT_BUSINESS_CATEGORY=Salon
TENANT_BUSINESS_CITY=Kuala Lumpur
TENANT_BUSINESS_TIMEZONE=Asia/Kuala_Lumpur
# MYR (Malaysia) or SGD (Singapore) for the two target markets - any code
# from app.schemas.validators.CURRENCY_CODES also works.
TENANT_BUSINESS_CURRENCY=MYR
